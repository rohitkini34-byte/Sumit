# Stage 2: Meta test number + "Clinic TEST" Google calendar (all free).
APP_ENV=staging
WA_MODE=live
CALENDAR_MODE=google
LLM_MODE=live
DEV_ALLOWED_NUMBERS=+91XXXXXXXXXX,+91YYYYYYYYYY   # your own verified test recipients (max 5)
PUBLIC_BASE_URL=https://<your-tunnel>.trycloudflare.com
ANTHROPIC_MONTHLY_BUDGET_NOTE=workspace clinic-agent-dev, low spend limit set in Console

WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=               # temporary (24h) token or System User token
WA_APP_SECRET=                 # App settings > Basic > App secret
WA_VERIFY_TOKEN=               # any random string; paste the same in the Meta webhook config
WA_GRAPH_API_VERSION=v21.0

ANTHROPIC_API_KEY=             # key from the clinic-agent-dev workspace
LLM_MODEL=claude-haiku-4-5-20251001

GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/secrets/gcal-sa.json
GOOGLE_CALENDAR_ID=            # "Clinic TEST" calendar id (shared with the service account)

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres   # Supabase free tier or local
FERNET_KEY=
PHONE_HASH_PEPPER=

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=           # python -c "import bcrypt;print(bcrypt.hashpw(b'pw', bcrypt.gensalt()).decode())"
SESSION_SECRET=
QUEUE_DISPLAY_KEY=             # long random string for the waiting-room TV URL

CLINIC_TIMEZONE=Asia/Kolkata
STAFF_WHATSAPP_NUMBERS=
