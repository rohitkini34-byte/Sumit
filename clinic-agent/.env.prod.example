# Stage 3: production. Nothing from dev/staging is reused. The app refuses to start if any
# mock/fake mode, DEV_ALLOWED_NUMBERS, or a dev default secret is set.
APP_ENV=prod
WA_MODE=live
CALENDAR_MODE=google
LLM_MODE=live
DEV_ALLOWED_NUMBERS=
PUBLIC_BASE_URL=https://clinic.example.in
ANTHROPIC_MONTHLY_BUDGET_NOTE=

WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=               # permanent System User token
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_API_VERSION=v21.0

ANTHROPIC_API_KEY=             # separate production key with its own spend limit
LLM_MODEL=claude-haiku-4-5-20251001

GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/secrets/gcal-sa.json   # NEW production service account
GOOGLE_CALENDAR_ID=            # the doctor's real calendar

DATABASE_URL=postgresql+asyncpg://...
FERNET_KEY=                    # new
PHONE_HASH_PEPPER=             # new
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=                # new
QUEUE_DISPLAY_KEY=             # new, long random

CLINIC_TIMEZONE=Asia/Kolkata
STAFF_WHATSAPP_NUMBERS=
